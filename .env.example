# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Gemini (AI coach) — https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeather (daily water intake suggestion) — https://openweathermap.org/api
EXPO_PUBLIC_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Firebase — see firebase.config.cjs / firebaseConfig.js (not in .env)

# One-time admin setup script only (not used by the app)
# ADMIN_PASSWORD=your_admin_password
